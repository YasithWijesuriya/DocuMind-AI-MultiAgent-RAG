{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.2.0",
      "maxDuration": 60,
      "memory": 3008
    }
  },
  "routes": [
    {
      "src": "/ask",
      "dest": "/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/info",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}