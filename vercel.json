{
  "version": 2,

  "functions": {
    "api/*.py": {
      "runtime": "@vercel/python@4.2.0",
      "maxDuration": 60
    }
  },

  "routes": [
    { "src": "/", "dest": "/api/index.py" },
    { "src": "/ask", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/info", "dest": "/api/index.py" }
  ],

  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
